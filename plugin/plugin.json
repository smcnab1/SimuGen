{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "simugen",
  "version": "1.1.0",
  "description": "Design, run, debrief and review fictional clinical simulations for healthcare education.",
  "author": {
    "name": "Sam McNab",
    "url": "https://github.com/smcnab1"
  },
  "homepage": "https://smcnab1.github.io/SimuGen/",
  "repository": "https://github.com/smcnab1/SimuGen",
  "license": "MIT",
  "keywords": [
    "healthcare",
    "simulation",
    "clinical-education",
    "scenario-design",
    "medical-education"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "SimuGen",
        "shortDescription": "Clinical simulation toolkit",
        "longDescription": "Create structured scenarios, practise fictional patient encounters turn by turn, reflect on your decisions in a guided debrief and review teaching scenarios.",
        "developerName": "Sam McNab",
        "category": "Education & Research",
        "capabilities": [
          "Generate clinical simulation scenarios",
          "Practise interactive patient encounters",
          "Debrief completed simulations",
          "Review scenarios for teaching"
        ],
        "websiteURL": "https://smcnab1.github.io/SimuGen/",
        "supportURL": "https://github.com/smcnab1/SimuGen/issues",
        "privacyPolicyURL": "https://smcnab1.github.io/SimuGen/privacy/",
        "termsOfServiceURL": "https://smcnab1.github.io/SimuGen/terms/",
        "defaultPrompt": [
          "Create a paramedic simulation scenario",
          "Run a fictional patient encounter, then debrief my decisions",
          "Review my clinical simulation scenario for teaching"
        ],
        "composerIcon": "./assets/logo.png",
        "logo": "./assets/logo.png"
      }
    }
  }
}
